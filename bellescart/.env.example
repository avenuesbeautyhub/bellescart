# API Configuration
BACKEND_API_URL=http://localhost:5000/api

# Environment
NODE_ENV=development
NEXT_PUBLIC_REQUEST_SIGNING_SECRET=your_request_signing_secret_here

# App Configuration
NEXT_PUBLIC_APP_NAME=BellesCart
NEXT_PUBLIC_APP_VERSION=1.0.0

# Feature Flags
NEXT_PUBLIC_ENABLE_MOCK_DATA=false
NEXT_PUBLIC_ENABLE_LOGGING=true

# Razor Pay Credential
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Shiprocket Configuration
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_EMAIL=your_shiprocket_email_here
SHIPROCKET_PASSWORD=your_shiprocket_password_here
SHIPROCKET_PICKUP_PINCODE=your_pickup_pincode_here

# Sentry Configuration
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here
NEXT_PUBLIC_SENTRY_RELEASE=1.0.0
NEXT_PUBLIC_APP_VERSION=1.0.0
SENTRY_ORG=your_sentry_org_here
SENTRY_PROJECT=your_sentry_project_here
SENTRY_AUTH_TOKEN=your_sentry_auth_token_here
