# Server Configuration
PORT=5000
NODE_ENV=development

# Production Status
DEV=true

# Admin Creation Key
ADMIN_REGISTRATION_KEY="your_admin_registration_key_here"

# Database
MONGODB_URI=mongodb+srv://your_mongodb_user:your_password@cluster.mongodb.net/database?appName=Cluster0

# Session Configuration
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d

# Request Signing Secret
REQUEST_SIGNING_SECRET=your_request_signing_secret_here

# CORS Configuration
FRONTEND_URL=http://localhost:3000
HOST_URL=https://bellescart.shop

# Email Configuration (for order notifications, etc.)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password

# AWS S3 Configuration (for product images)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=bellescart-product-images

# Stripe Configuration (for payments)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay Configuration
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Courier Support - Shiprocket
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_PASSWORD=your_shiprocket_password_here
SHIPROCKET_EMAIL=your_shiprocket_email_here

# Shipping Configuration
DEFAULT_PRODUCT_WEIGHT=0.070
PICKUP_PINCODE=your_pickup_pincode
PICKUP_ADDRESS=Your Pickup Address
PICKUP_CITY=Your City
PICKUP_STATE=Your State

# Shypfy Configuration
SHYPFY_CLIENT_ID=your_shypfy_client_id
SHYPFY_USERNAME=your_shypfy_username
SHYPFY_PASSWORD=your_shypfy_password

# Nimbus Configuration
NIMBUS_BASE_URL=https://api.nimbuspost.com

# Sentry Configuration
SENTRY_DSN=your_sentry_dsn_here
SENTRY_RELEASE=1.0.0
APP_VERSION=1.0.0
